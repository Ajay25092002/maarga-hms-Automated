# FastAPI base URL reachable from the scheduler containers.
# On Windows Docker Desktop, host.docker.internal usually reaches the host.
BILLING_API_URL=https://your-hospital-domain.com

# Must match INTERNAL_BILLING_TOKEN in the backend environment.
INTERNAL_BILLING_TOKEN=replace-with-a-long-random-secret

# Redis broker/result backend. If Redis runs in the same Docker network
# with container name "redis", these values are correct.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

BILLING_REQUEST_TIMEOUT_SECONDS=600
TZ=Asia/Kolkata

# Optional: comma-separated exact service names. If omitted, the backend
# uses AUTOMATED_IP_SERVICE_NAMES configured in billing_service.py.
# AUTOMATED_IP_SERVICE_NAMES=Room Charges,Holistic Therapies,Diet & Food
